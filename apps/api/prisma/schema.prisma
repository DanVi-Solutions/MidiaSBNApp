generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS:
enum CredentialStatus {
  ACTIVE
  INACTIVE
  PENDING
  RECOVERING
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum WorshipService {
  SUNDAY_0815
  SUNDAY_1030
  SUNDAY_1800
}

enum ChangeStatus {
  NONE
  REQUESTED
  REJECTED
  DECLINED
}

enum Role {
  ADMINISTRATOR
  GENERAL_MANAGER
  DEPARTMENT_MANAGER
  SCHEDULER_MANAGER
  VOLUNTEER
}

enum NotificationType {
  SCHEDULE_ASSIGNED
  SCHEDULE_UNASSIGNED
  SCHEDULE_CHANGED
  SCHEDULE_CANCELLED
  SCHEDULE_REMINDER
  SELF_SIGNUP_OPENED
  CHANGE_REQUEST_RECEIVED
  CHANGE_REQUEST_ACCEPTED
  CHANGE_REQUEST_REJECTED
  CHANGE_REQUEST_CANCELLED
  TRANSFER_REQUESTED
  TRANSFER_REJECTED
  DEPARTMENT_CHANGED
  ROLE_CHANGED
  UNAVAILABILITY_CONFLICT
  SCHEDULE_CYCLE_OPENED
  ASSIGNMENT_DECLINED
  PRESENCE_NOT_CONFIRMED
}

// SCHEMAS:
model Credential {
  id                   String           @id @default(uuid(7)) @db.Uuid
  name                 String           @db.VarChar(80)
  username             String?          @unique @db.VarChar(15)
  status               CredentialStatus @default(PENDING)
  role                 Role             @default(VOLUNTEER)
  credentialNumber     String?          @unique @map("credential_number") @db.VarChar(30)
  credentialNumberHash String?          @unique @map("credential_number_hash") @db.Char(64)
  worshipService       WorshipService?  @map("worship_service")

  availabilities         Availability[]
  departments            CredentialDepartment[] @relation("CredentialDepartments")
  refreshTokens          RefreshToken[]
  schedules              CredentialSchedule[]
  credentialChanges      CredentialSchedule[]   @relation("CredentialChange")
  requestedTransfers     CredentialDepartment[] @relation("TransferRequestedBy")
  unavailabilities       Unavailability[]
  createdRecurringEvents RecurringEvent[]       @relation("CreatedRecurringEvents")
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]

  @@map("credential")
}

model RefreshToken {
  id           String   @id @default(uuid(7)) @db.Uuid
  credentialId String   @map("credential_id") @db.Uuid
  tokenHash    String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  startedAt    DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  userAgent    String?  @map("user_agent") @db.VarChar(255)

  credential        Credential         @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]

  @@index([credentialId])
  @@map("refresh_token")
}

model Department {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String  @unique @db.VarChar(80)
  description String? @db.VarChar(255)

  credentials     CredentialDepartment[]     @relation("DepartmentCredentials")
  transfersFrom   CredentialDepartment[]     @relation("TransferFrom")
  schedules       Schedule[]
  recurringEvents RecurringEventDepartment[]

  @@map("department")
}

model CredentialDepartment {
  id                       String  @id @default(uuid(7)) @db.Uuid
  credentialId             String  @map("credential_id") @db.Uuid
  departmentId             String  @map("department_id") @db.Uuid
  pending                  Boolean @default(false)
  transferFromDepartmentId String? @map("transfer_from_department_id") @db.Uuid
  transferRequestedById    String? @map("transfer_requested_by_id") @db.Uuid

  credential             Credential  @relation("CredentialDepartments", fields: [credentialId], references: [id], onDelete: Cascade)
  department             Department  @relation("DepartmentCredentials", fields: [departmentId], references: [id], onDelete: Cascade)
  transferFromDepartment Department? @relation("TransferFrom", fields: [transferFromDepartmentId], references: [id], onDelete: Cascade)
  transferRequestedBy    Credential? @relation("TransferRequestedBy", fields: [transferRequestedById], references: [id], onDelete: SetNull)

  @@unique([credentialId, departmentId])
  @@index([departmentId, pending])
  @@map("credential_department")
}

model Schedule {
  id                     String    @id @default(uuid(7)) @db.Uuid
  name                   String    @db.VarChar(80)
  scheduleAt             DateTime  @map("schedule_at") @db.Timestamptz(6)
  departmentId           String    @map("department_id") @db.Uuid
  published              Boolean   @default(false)
  description            String?   @db.VarChar(255)
  recurringEventId       String?   @map("recurring_event_id") @db.Uuid
  selfSignup             Boolean   @default(false) @map("self_signup")
  volunteersNeeded       Int?      @map("volunteers_needed") @db.SmallInt
  attendanceNoticeSentAt DateTime? @map("attendance_notice_sent_at") @db.Timestamptz(6)

  credentials   CredentialSchedule[]
  notifications Notification[]

  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  recurringEvent RecurringEvent? @relation(fields: [recurringEventId], references: [id], onDelete: SetNull)

  @@unique([recurringEventId, departmentId, scheduleAt])
  @@index([departmentId, scheduleAt])
  @@index([recurringEventId])
  @@map("schedule")
}

model RecurringEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  weekday     Weekday
  isGlobal    Boolean  @default(false) @map("is_global")
  createdById String?  @map("created_by_id") @db.Uuid
  times       String[] @db.VarChar(5)

  createdBy   Credential?                @relation("CreatedRecurringEvents", fields: [createdById], references: [id], onDelete: SetNull)
  departments RecurringEventDepartment[]
  schedules   Schedule[]

  @@index([isGlobal])
  @@index([createdById])
  @@map("recurring_event")
}

model RecurringEventDepartment {
  recurringEventId String @map("recurring_event_id") @db.Uuid
  departmentId     String @map("department_id") @db.Uuid

  recurringEvent RecurringEvent @relation(fields: [recurringEventId], references: [id], onDelete: Cascade)
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([recurringEventId, departmentId])
  @@index([departmentId])
  @@map("recurring_event_department")
}

model CredentialSchedule {
  id                 String       @id @default(uuid(7)) @db.Uuid
  credentialId       String       @map("credential_id") @db.Uuid
  scheduleId         String       @map("schedule_id") @db.Uuid
  changeStatus       ChangeStatus @default(NONE) @map("change_status")
  credentialChangeId String?      @map("credential_change_id") @db.Uuid
  reminderSentAt     DateTime?    @map("reminder_sent_at") @db.Timestamptz(6)
  confirmedAt        DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  checkedInAt        DateTime?    @map("checked_in_at") @db.Timestamptz(6)

  credential       Credential  @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  credentialChange Credential? @relation("CredentialChange", fields: [credentialChangeId], references: [id], onDelete: SetNull)
  schedule         Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([credentialId, scheduleId])
  @@index([scheduleId])
  @@index([credentialChangeId])
  @@map("credential_schedule")
}

model Availability {
  id           String  @id @default(uuid(7)) @db.Uuid
  credentialId String  @map("credential_id") @db.Uuid
  weekday      Weekday
  morning      Boolean @default(false)
  afternoon    Boolean @default(false)
  night        Boolean @default(false)

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, weekday])
  @@index([weekday])
  @@map("availability")
}

model Unavailability {
  id           String   @id @default(uuid(7)) @db.Uuid
  credentialId String   @map("credential_id") @db.Uuid
  startAt      DateTime @map("start_at") @db.Timestamptz(6)
  endAt        DateTime @map("end_at") @db.Timestamptz(6)
  reason       String?  @db.VarChar(255)

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, startAt])
  @@map("unavailability")
}

model Notification {
  id           String           @id @default(uuid(7)) @db.Uuid
  credentialId String           @map("credential_id") @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(120)
  body         String           @db.VarChar(255)
  link         String?          @db.VarChar(255)
  scheduleId   String?          @map("schedule_id") @db.Uuid
  readAt       DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  schedule   Schedule?  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([credentialId, createdAt(sort: Desc)])
  @@index([scheduleId])
  @@index([createdAt])
  @@map("notification")
}

model PushSubscription {
  id           String   @id @default(uuid(7)) @db.Uuid
  credentialId String   @map("credential_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  endpoint     String   @unique @db.VarChar(1024)
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  credential Credential   @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  session    RefreshToken @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([sessionId])
  @@map("push_subscription")
}

model JobMarker {
  key       String   @id @db.VarChar(60)
  value     String   @db.VarChar(60)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("job_marker")
}
